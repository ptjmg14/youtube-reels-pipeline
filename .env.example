# Copia para .env e preenche. A reescrita (passo mandatório) precisa de uma
# chave Gemini no free tier.
GEMINI_API_KEY=<coloca aqui a tua chave Gemini free tier>
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_EMBEDDING_MODEL=text-embedding-004
# REELS_EMBEDDING=local

# Nome da fonte para a citação ("根據 <fonte> 報導...")
# REELS_SOURCE_NAME=HEALTH 2.0
# Idioma dos scripts reescritos
# REELS_OUTPUT_LANG=繁體中文
# Voz e velocidade da narração (edge-tts, gratuito)
# REELS_TTS_VOICE=zh-TW-HsiaoYuNeural
# REELS_TTS_RATE=+5%

# Modelo local de transcrição (fallback quando não há legendas nem Groq)
# WHISPER_MODEL=base

# Transcrição rápida via Groq Whisper large-v3-turbo (grátis no free tier).
# "auto" usa Groq se GROQ_API_KEY estiver definida, senão whisper local.
REELS_TRANSCRIBER=auto
GROQ_API_KEY=<coloca aqui a tua chave Groq free tier (console.groq.com)>
# GROQ_MODEL=whisper-large-v3-turbo

# Índice: Pinecone primário (server-side embeddings multilingual-e5-large) com
# espelho local Chroma. Com REELS_VECTORDB_BACKUP=none fica só Pinecone.
REELS_VECTORDB=pinecone
REELS_VECTORDB_BACKUP=chroma
PINECONE_API_KEY=<coloca aqui a tua chave Pinecone>
# PINECONE_INDEX_NAME=reels
# PINECONE_REGION=us-east-1
# PINECONE_EMBEDDING_MODEL=multilingual-e5-large

# Dedupe por similitude textual da transcrição (Jaccard de n-gramas; recall
# semântico no índice). 0 desliga.
# REELS_DEDUPE_THRESHOLD=0.7