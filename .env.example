# Copy to .env and fill in. Rewriting (mandatory step) requires a
# Gemini API key on the free tier.
GEMINI_API_KEY=<your_gemini_api_key_here>
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=text-embedding-004
# REELS_EMBEDDING=local

# Fallback when the Gemini free-tier daily quota is exhausted (429): retry the
# rewrite/evaluation on Groq free-tier chat models (no credit card needed).
# Set REELS_LLM_FALLBACK=off to disable. Multiple models are tried in order —
# Groq quotas are per model, so each extra model multiplies the daily budget.
# REELS_LLM_FALLBACK=groq
# REELS_LLM_FALLBACK_MODELS=llama-3.3-70b-versatile, openai/gpt-oss-120b, llama-3.1-8b-instant

# Source name used in the mandatory citation ("According to <source>'s reporting...").
# Leave unset to auto-detect the source from the YouTube channel of each video.
# REELS_SOURCE_NAME=

# Language of the rewritten scripts (e.g. pt, en, zh-TW)
# REELS_OUTPUT_LANG=pt
# TTS voice and rate (edge-tts, free). Examples:
#   Portuguese: pt-PT-RaquelNeural, pt-BR-FranciscaNeural
#   English:    en-US-ChristopherNeural, en-US-JennyNeural
#   Chinese:    zh-TW-HsiaoYuNeural
# REELS_TTS_VOICE=pt-PT-RaquelNeural
# REELS_TTS_RATE=+5%

# Local transcription model (fallback when no captions or Groq API)
# WHISPER_MODEL=base

# Fast transcription via Groq Whisper large-v3-turbo (free on free tier).
# "auto" uses Groq if GROQ_API_KEY is defined, otherwise falls back to local Whisper.
REELS_TRANSCRIBER=auto
GROQ_API_KEY=<your_groq_api_key_here_from_console_groq_com>
# GROQ_MODEL=whisper-large-v3-turbo

# Index: Primary Pinecone (server-side embeddings multilingual-e5-large) with
# a local Chroma mirror backup. Setting REELS_VECTORDB_BACKUP=none disables the backup.
REELS_VECTORDB=pinecone
REELS_VECTORDB_BACKUP=chroma
PINECONE_API_KEY=<your_pinecone_api_key_here>
# PINECONE_INDEX_NAME=reels
# PINECONE_REGION=us-east-1
# PINECONE_EMBEDDING_MODEL=multilingual-e5-large

# Deduplication threshold by textual similarity of the transcript (Jaccard of n-grams;
# semantic recall on the index). 0 disables deduplication.
# REELS_DEDUPE_THRESHOLD=0.7
